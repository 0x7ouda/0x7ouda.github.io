---
import Base from '../layouts/Base.astro';
import Investigation from '../components/Investigation.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import SectionNav from '../components/SectionNav.astro';
import CommandSearch from '../components/CommandSearch.astro';
import TagRail from '../components/TagRail.astro';

import { getPosts } from '../lib/content';
import { path } from '../lib/site';

const posts = await getPosts();
const homeUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Base home>
  <div class="home-intro">
    <picture class="hero-background" aria-hidden="true">
      <source
        srcset={path('images/forensic-lab-hero.avif')}
        type="image/avif"
      />

      <img
        src={path('images/forensic-lab-hero.webp')}
        width="1536"
        height="864"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <div class="hero-shade" aria-hidden="true"></div>

    <section class="hero container" aria-label="The investigation lab">
      <div class="hero-copy">
        <h1 class="hero-statement">
          <span class="hero-word">Observing.</span>
          <span class="hero-word hero-word-accent">Investigating.</span>
          <span class="hero-word">Documenting.</span>
        </h1>
      </div>

      <Investigation />
    </section>

    <CommandSearch />
    <SectionNav />
    <TagRail posts={posts} />
  </div>

  <section class="container research-section" id="latest">
    <div class="section-heading">
      <div>
        <span class="eyebrow section-number">01 / FROM THE LAB</span>
        <h2>Latest findings.</h2>
      </div>

      <a class="text-link" href={path('research/')}>
        All research <Icon name="arrow" size={16} />
      </a>
    </div>

    <div class="latest-heading">
      <h2>All dispatches</h2>
      <span>OBSERVATIONS → UNDERSTANDING</span>
    </div>

    <p
      class="tag-filter-notice"
      data-tag-filter-status
      hidden
      aria-live="polite"
    >
      Showing <strong data-active-tag></strong> —{' '}
      <span data-results-count></span> posts.
      <a href={`${homeUrl}#latest`}>Clear filter</a>
    </p>

    <div class="post-grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</Base>

<script>
  function applyTagFilter() {
    const selectedTag = new URLSearchParams(window.location.search)
      .get('tag')
      ?.trim()
      .toLowerCase();

    const cards = document.querySelectorAll<HTMLElement>(
      '.post-grid [data-post-card]',
    );
    let visibleCount = 0;

    cards.forEach((card) => {
      const tags = (card.dataset.tags ?? '').split('|||');
      const matches = !selectedTag || tags.includes(selectedTag);
      card.hidden = !matches;
      if (matches) visibleCount++;
    });

    const notice = document.querySelector<HTMLElement>(
      '[data-tag-filter-status]',
    );
    const activeTag = document.querySelector<HTMLElement>('[data-active-tag]');
    const resultsCount = document.querySelector<HTMLElement>(
      '[data-results-count]',
    );

    if (notice) notice.hidden = !selectedTag;
    if (activeTag) activeTag.textContent = selectedTag ?? '';
    if (resultsCount) resultsCount.textContent = String(visibleCount);
  }

  applyTagFilter();
  document.addEventListener('astro:page-load', applyTagFilter);
</script>

<style>
  /* The existing card layout can override the browser's default [hidden] style. */
  :global(.post-grid [data-post-card][hidden]),
  .tag-filter-notice[hidden] {
    display: none !important;
  }

  .tag-filter-notice {
    margin: 0 0 20px;
    color: var(--faint);
    font: 13px/1.6 var(--mono);
  }

  .tag-filter-notice strong {
    color: var(--text);
  }

  .tag-filter-notice a {
    color: var(--green);
    margin-inline-start: 10px;
  }
</style>
