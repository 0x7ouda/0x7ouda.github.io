---
import Icon from './Icon.astro';
---

<div class="investigation" data-investigation>
  <div class="scene-label">
    <span class="scene-cross">+</span>
    <span>THE PURSUIT OF UNDERSTANDING</span>
    <span class="scene-cross">+</span>
  </div>
  <svg
    class="investigation-scene"
    viewBox="0 0 600 380"
    role="img"
    aria-labelledby="investigation-title investigation-desc"
  >
    <title id="investigation-title">The investigator and the elusive evidence</title>
    <desc id="investigation-desc">
      A persistent investigator with a magnifying glass follows a mischievous
      green virus between evidence markers. The scene can be paused using the
      button below.
    </desc>
    <defs>
      <pattern
        id="scene-grid"
        width="32"
        height="32"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M32 0H0V32"
          fill="none"
          stroke="#97aa88"
          stroke-opacity=".07"
        />
      </pattern>
      <radialGradient id="scene-light">
        <stop stop-color="#687a46" stop-opacity=".17" />
        <stop offset="1" stop-color="#161b13" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="lens" x2="1" y2="1">
        <stop stop-color="#b9d79a" stop-opacity=".18" />
        <stop offset="1" stop-color="#b9d79a" stop-opacity=".02" />
      </linearGradient>
    </defs>
    <rect width="600" height="380" fill="url(#scene-grid)" />
    <ellipse cx="330" cy="200" rx="290" ry="200" fill="url(#scene-light)" />
    <g stroke="#718265" stroke-width="1" opacity=".35" fill="none">
      <path
        d="M56 281h80l74-113 101 93 105-101 112 50"
        stroke-dasharray="3 7"
      />
      <circle cx="136" cy="281" r="4" />
      <circle cx="210" cy="168" r="4" />
      <circle cx="311" cy="261" r="4" />
      <circle cx="416" cy="160" r="4" />
    </g>
    <g transform="translate(64 206) rotate(-12)" class="scene-evidence">
      <rect width="64" height="77" rx="3" fill="#1b201a" stroke="#3a4434" />
      <path d="M12 18h26M12 27h38M12 36h30M12 57h17" stroke="#65705a" />
      <text x="39" y="67" fill="#9daa8a" font-size="10" font-family="monospace">
        01
      </text>
    </g>
    <g transform="translate(457 90) rotate(9)" class="scene-evidence">
      <path d="M0 7h24l7 7h46v57H0Z" fill="#25291e" stroke="#535b3d" />
      <path d="M12 31h36m-36 9h48" stroke="#777e57" stroke-opacity=".5" />
      <text x="50" y="60" fill="#9daa8a" font-size="10" font-family="monospace">
        02
      </text>
    </g>
    <g transform="translate(388 302)">
      <circle r="21" fill="none" stroke="#535b3d" stroke-dasharray="2 5" />
      <path d="M-5 0H5M0-5V5" stroke="#a2b886" />
      <text
        x="33"
        y="4"
        fill="#8c9781"
        font-size="9"
        font-family="monospace"
        letter-spacing="1"
      >
        TRACE FOUND
      </text>
    </g>
    <g id="investigator-character" transform="translate(182 200)">
      <ellipse cx="0" cy="67" rx="41" ry="8" fill="#000" opacity=".27" />
      <g class="investigator-body">
        <path
          d="m-17 35-9 27 14 3 17-30m9-1 7 28 16-2-8-30"
          stroke="#a49c7e"
          stroke-width="9"
          fill="none"
          stroke-linecap="round"
        />
        <path
          d="m-30 65 18 2m28-2 19-1"
          stroke="#ded8c1"
          stroke-width="8"
          stroke-linecap="round"
        />
        <path d="M-24-4Q-36 15-35 40q34 14 65-1L20-5Z" fill="#a99e7b" />
        <path
          d="m-7-7-8 19 14 7-4 25M8-6l10 18-14 7"
          fill="#c6bb98"
          stroke="#776f57"
          stroke-width="1.5"
        />
        <path d="M-33 28h60" stroke="#776f57" stroke-width="3" />
        <circle cx="0" cy="29" r="3" fill="#e1d7b6" />
        <path
          d="M-25 3q-20 16-11 30l13 1"
          fill="none"
          stroke="#a99e7b"
          stroke-width="14"
          stroke-linecap="round"
        />
        <path
          d="m17 3 16 13 21-19"
          fill="none"
          stroke="#b6aa85"
          stroke-width="13"
          stroke-linecap="round"
        />
        <circle cx="54" cy="-3" r="8" fill="#e0c5a4" />
        <path
          d="M-19-43q1-23 23-18 24 4 21 26L16-14q-5 13-24 7-15-5-14-20Z"
          fill="#dec7a6"
        />
        <path
          d="M-21-33q-9-33 20-36 32-2 29 27l-11-8-14 6-19-2 1 16"
          fill="#343b31"
        />
        <path d="m24-34 8 9-11 3" fill="#dec7a6" />
        <path
          d="m4-36 8-2m7 0 8 1"
          stroke="#4f5143"
          stroke-width="2.5"
          stroke-linecap="round"
        />
        <circle cx="9" cy="-30" r="2" fill="#282e24" />
        <circle cx="23" cy="-30" r="2" fill="#282e24" />
        <path
          d="M10-17q7 3 11-2"
          fill="none"
          stroke="#8a765d"
          stroke-width="1.6"
        />
        <g class="magnifying-glass">
          <path
            d="m52 0 14-22"
            stroke="#ccd3b7"
            stroke-width="7"
            stroke-linecap="round"
          />
          <circle
            cx="81"
            cy="-45"
            r="29"
            fill="url(#lens)"
            stroke="#b5c69a"
            stroke-width="5"
          />
          <path
            d="M61-48q2-17 20-19"
            fill="none"
            stroke="#eef0db"
            stroke-opacity=".7"
            stroke-width="2"
            stroke-linecap="round"
          />
          <circle
            cx="82"
            cy="-44"
            r="35"
            fill="none"
            stroke="#a6c28a"
            stroke-opacity=".12"
          />
        </g>
      </g>
    </g>
    <g id="virus-character" transform="translate(401 209)">
      <ellipse cy="42" rx="28" ry="6" fill="#000" opacity=".22" />
      <g class="virus-body">
        <g stroke="#94b477" stroke-width="6" stroke-linecap="round">
          <path d="m0-26 1-13m18 21 10-10m-47 9-10-10M-26 1l-13 1m65 0 13-2m-21 20 9 10m-45-10-8 11M1 25v12" />
        </g>
        <g fill="#abc78c">
          <circle cy="-40" cx="1" r="5" />
          <circle cy="-30" cx="29" r="5" />
          <circle cy="-29" cx="-29" r="5" />
          <circle cy="2" cx="-40" r="5" />
          <circle cy="0" cx="40" r="5" />
          <circle cy="31" cx="27" r="5" />
          <circle cy="32" cx="-27" r="5" />
          <circle cy="38" cx="1" r="5" />
        </g>
        <path
          d="M-28-4q1-26 28-26Q30-29 30 0q-1 28-30 28Q-29 26-28-4Z"
          fill="#a6c785"
        />
        <path
          d="M-23-10q1-13 13-15"
          fill="none"
          stroke="#d1e3b8"
          stroke-width="3"
          stroke-linecap="round"
        />
        <circle cx="-15" cy="9" r="4" fill="#86a968" />
        <circle cx="18" cy="-14" r="3" fill="#86a968" />
        <ellipse cx="-7" cy="-4" rx="6" ry="8" fill="#eff3da" />
        <ellipse cx="10" cy="-4" rx="6" ry="8" fill="#eff3da" />
        <circle cx="-9" cy="-3" r="3" fill="#263524" />
        <circle cx="8" cy="-3" r="3" fill="#263524" />
        <path
          d="m-14-17 10 3m9-1 10-4"
          stroke="#405e31"
          stroke-width="2.5"
          stroke-linecap="round"
        />
        <path
          d="M-4 11q11 7 17-2"
          fill="none"
          stroke="#405e31"
          stroke-width="2.5"
          stroke-linecap="round"
        />
      </g>
    </g>
    <g
      fill="#859178"
      font-size="9"
      font-family="monospace"
      letter-spacing="1.3"
    >
      <text x="29" y="38">
        OBSERVE.
      </text>
      <text x="29" y="53">
        CORRELATE.
      </text>
      <text x="29" y="68">
        UNDERSTAND.
      </text>
    </g>
  </svg>
  <div class="scene-footer">
    <button class="scene-replay" data-new-trace>
      Evidence moves. Follow it.
      <Icon name="arrow" size={14} />
    </button>
    <button
      class="scene-pause icon-button"
      data-pause-scene
      aria-label="Pause investigation animation"
      aria-pressed="false"
    >
      <Icon name="pause" size={14} />
    </button>
  </div>
</div>
<script>
  import '../scripts/investigation';
</script>
