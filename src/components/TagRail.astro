---
type TagPost = {
  collection: string;
  data: {
    tags?: string[];
  };
};

const { posts = [] } = Astro.props as {
  posts?: TagPost[];
};

const tagCounts = new Map<string, number>();

for (const post of posts) {
  for (const rawTag of post.data.tags ?? []) {
    const tag = String(rawTag).trim();

    if (!tag) continue;

    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);

const homeUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const tagUrl = (tag: string) =>
  `${homeUrl}?tag=${encodeURIComponent(tag)}#latest`;
---

{tags.length > 0 && (
  <section class="tag-rail" aria-label="Explore content by tag">
    <div class="tag-rail-inner container">
      <div class="tag-rail-heading">
        <span># EXPLORE BY TAG</span>
      </div>

      <div class="tag-rail-viewport">
        <div class="tag-rail-track">
          <div class="tag-rail-group">
            {tags.map(([tag, count]) => (
              <a
                class="tag-rail-chip"
                href={tagUrl(tag)}
                aria-label={`Show posts tagged ${tag}`}
              >
                <span class="tag-hash">#</span>
                <span>{tag}</span>
                <sup>{count}</sup>
              </a>
            ))}
          </div>

          <div class="tag-rail-group" aria-hidden="true">
            {tags.map(([tag, count]) => (
              <a class="tag-rail-chip" href={tagUrl(tag)} tabindex="-1">
                <span class="tag-hash">#</span>
                <span>{tag}</span>
                <sup>{count}</sup>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .tag-rail {
    position: relative;
    padding: 10px 0 22px;
  }

  .tag-rail-inner {
    min-width: 0;
    width: min(860px, calc(100% - 96px));
    margin-inline: auto;
  }

  .tag-rail-heading {
    display: flex;
    align-items: center;
    margin-bottom: 9px;
  }

  .tag-rail-heading > span {
    color: var(--faint);
    font: 10px/1.4 var(--mono);
    letter-spacing: 0.14em;
  }

  .tag-rail-viewport {
    position: relative;
    overflow: hidden;

    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 4%,
      #000 96%,
      transparent
    );

    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 4%,
      #000 96%,
      transparent
    );
  }

  .tag-rail-track {
    display: flex;
    width: max-content;

    animation: tag-rail-move 35s linear infinite;

    will-change: transform;
  }

  @media (hover: hover) {
    .tag-rail:hover .tag-rail-track {
      animation-play-state: paused;
    }
  }

  .tag-rail-group {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-right: 8px;
  }

  .tag-rail-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    min-height: 40px;
    padding: 9px 14px;

    border: 1px solid #768b682c;
    border-radius: 7px;

    background: #18201780;
    color: #abb5a4;

    font: 13px var(--mono);
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;

    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s,
      transform 0.2s;
  }

  .tag-rail-chip:hover {
    color: var(--text);
    border-color: #9fc38170;
    background: #25321f;

    transform: translateY(-1px);
  }

  .tag-rail-chip:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }

  .tag-hash {
    color: var(--green);
  }

  .tag-rail-chip sup {
    position: relative;
    top: -1px;

    color: var(--faint);

    font-size: 11px;
    font-weight: 600;
  }

  @keyframes tag-rail-move {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 600px) {
    .tag-rail {
      padding-top: 8px;
    }

    .tag-rail-inner {
      width: calc(100% - 36px);
    }

    .tag-rail-viewport {
      overflow: hidden;

      mask-image: linear-gradient(
        90deg,
        transparent,
        #000 4%,
        #000 96%,
        transparent
      );

      -webkit-mask-image: linear-gradient(
        90deg,
        transparent,
        #000 4%,
        #000 96%,
        transparent
      );
    }

    .tag-rail-track {
      animation: tag-rail-move 35s linear infinite;
    }

    .tag-rail-group[aria-hidden='true'] {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-rail-track {
      animation: none;
    }

    .tag-rail-viewport {
      overflow-x: auto;

      mask-image: none;
      -webkit-mask-image: none;
    }

    .tag-rail-group[aria-hidden='true'] {
      display: none;
    }
  }
</style>
